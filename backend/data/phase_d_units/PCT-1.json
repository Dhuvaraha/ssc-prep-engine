{
  "objective_id": "PCT-1",
  "prerequisites": [
    "Count equal parts and distinguish selected parts from the whole.",
    "Read a fraction as numerator divided by denominator."
  ],
  "explanation": "Percent means per hundred. A fraction, a decimal and a percentage can describe the same share of one stated whole. Changing the representation does not change that share.",
  "worked": [
    {
      "action": "Shade one of four equal parts of a square.",
      "justification": "The shaded fraction is 1/4 because four parts make the whole."
    },
    {
      "action": "Split each quarter into 25 equal cells, giving 100 cells altogether.",
      "justification": "The shaded quarter now contains 25 cells, so 1/4 = 25/100 = 25%."
    },
    {
      "action": "Write 25/100 = 0.25.",
      "justification": "The decimal is another representation of the same share; 25% is not the number 25 wholes."
    }
  ],
